<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <DefineConstants>$(DefineConstants);REDISENO_VISUAL</DefineConstants>
    <RootNamespace>GestionEstudiante</RootNamespace>
    <ApplicationManifest>../app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../FrmGestionEstudiantes.cs" Link="Original/FrmGestionEstudiantes.cs" />
    <Compile Include="../FrmGestionEstudiantes.Designer.cs" Link="Original/FrmGestionEstudiantes.Designer.cs" />
    <Compile Include="../model/*.cs" Link="Original/model/%(Filename)%(Extension)" />
    <Compile Include="../repository/*.cs" Link="Original/repository/%(Filename)%(Extension)" />
    <Compile Include="../service/*.cs" Link="Original/service/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../FrmGestionEstudiantes.resx" Link="FrmGestionEstudiantes.resx" />
  </ItemGroup>
</Project>
