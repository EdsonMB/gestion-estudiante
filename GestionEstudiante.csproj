<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tmp\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <EmbeddedResource Remove="tmp\**\*" />
    <Compile Update="ui\FrmEstudiante.cs" />
    <Compile Update="ui\FrmArchivos.cs" />
    <Compile Update="ui\FrmEstudiante.Designer.cs"><DependentUpon>FrmEstudiante.cs</DependentUpon></Compile>
    <Compile Update="ui\FrmArchivos.Designer.cs"><DependentUpon>FrmArchivos.cs</DependentUpon></Compile>
    <EmbeddedResource Update="ui\FrmEstudiante.resx"><DependentUpon>FrmEstudiante.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Update="ui\FrmArchivos.resx"><DependentUpon>FrmArchivos.cs</DependentUpon></EmbeddedResource>
    <Compile Update="ui\FrmGestionEstudiantes.cs" />
    <Compile Update="ui\FrmGestionEstudiantes.Designer.cs">
      <DependentUpon>FrmGestionEstudiantes.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="ui\FrmGestionEstudiantes.resx">
      <DependentUpon>FrmGestionEstudiantes.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="ui\FrmAcceso.cs" />
    <Compile Update="ui\FrmAcceso.Designer.cs">
      <DependentUpon>FrmAcceso.cs</DependentUpon>
    </Compile>
    <Compile Update="ui\FrmInicio.cs" />
    <Compile Update="ui\FrmInicio.Designer.cs">
      <DependentUpon>FrmInicio.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
